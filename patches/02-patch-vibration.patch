--- a/bootable/recovery/minuitwrp/events.cpp
+++ b/bootable/recovery/minuitwrp/events.cpp
@@ -52,6 +52,8 @@
 
 #define LEDS_HAPTICS_DURATION_FILE    "/sys/class/leds/vibrator/duration"
 #define LEDS_HAPTICS_ACTIVATE_FILE    "/sys/class/leds/vibrator/activate"
+#define LEDS_HAPTICS_BRIGHTNESS_FILE  "/sys/class/leds/vibrator/brightness"
+#define LEDS_HAPTICS_TRIGGER_FILE     "/sys/class/leds/vibrator/trigger"
 
 #ifndef SYN_REPORT
 #define SYN_REPORT          0x00
@@ -132,9 +134,16 @@ int vibrate(int timeout_ms)
 #elif defined(USE_SAMSUNG_HAPTICS)
     if (std::ifstream(VIBRATOR_TIMEOUT_FILE).good()) {
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
 #else
-    if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
+    if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good() || std::ifstream(LEDS_HAPTICS_TRIGGER_FILE).good()) {
+        // Re-prime transient state machine as brightness 0 drops it to 'none'
+        write_to_file(LEDS_HAPTICS_TRIGGER_FILE, "transient");
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
+        write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "255");
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
+        
+        // Let hardware rumble for requested duration
+        usleep(timeout_ms * 1000);
+        
+        // Force clear brightness and activation to break physical voltage latch
+        write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "0");
+        write_to_file(LEDS_HAPTICS_BRIGHTNESS_FILE, "0");
     } else
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
 #endif