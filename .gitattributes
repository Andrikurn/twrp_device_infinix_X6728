# Set default behavior: normalize line endings to LF in the repo,
# and check out as LF too (so no CRLF ever gets reintroduced on any OS).
* text=auto eol=lf

# Explicitly treat common Android/Make source as text (belt-and-suspenders
# in case git's own heuristics misdetect something as binary).
*.mk        text eol=lf
*.bp        text eol=lf
*.rc        text eol=lf
*.sh        text eol=lf
*.c         text eol=lf
*.cpp       text eol=lf
*.h         text eol=lf
*.xml       text eol=lf
*.prop      text eol=lf